# Puerto en el que se publica la base. Cambielo si ya tiene PostgreSQL en el 5432.
DB_PUERTO=5432
# =============================================================================
# VARIABLES DE LA API
#
# La lista de nombres es LA MISMA en local, en preproduccion y en produccion.
# Lo unico que cambia son los valores. Ese es el contrato que permite que un dev
# no tenga que aprenderse AWS para trabajar: escribe contra estos nombres y la
# plataforma se encarga de que tengan el valor correcto en cada entorno.
#
# Uso:  cp .env.example .env  y pegar lo que genero el bootstrap
#       (entorno/generado/entorno.generado.env)
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos
#
# La API se conecta como `raiz_api` y por cada peticion hace
# SET LOCAL ROLE authenticated. Nunca como superusuario: PostgreSQL omite las
# politicas RLS para el dueno de las tablas, asi que conectarse como postgres
# desactivaria en silencio todo el control de acceso.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://raiz_api:raiz_local@localhost:5432/raiz

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1

# Endpoints: SOLO tienen valor en local, apuntando a los emuladores.
# En preproduccion y produccion van VACIOS y el SDK resuelve los endpoints
# reales de AWS. Es, literalmente, la unica diferencia entre este archivo y el
# de produccion.
S3_ENDPOINT=http://localhost:4566
COGNITO_ENDPOINT=http://localhost:9229

S3_BUCKET_FOTOS=raiz-fotos

# Credenciales: en local son literales de mentira, porque los emuladores no las
# validan. En AWS NO se define ninguna: la tarea toma credenciales temporales de
# su rol de IAM. Una clave de acceso escrita en un archivo de entorno es un
# hallazgo de seguridad, no una configuracion.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# -----------------------------------------------------------------------------
# Cognito
#
# Los genera el bootstrap en cada maquina, asi que no se versionan.
# Copiar de entorno/generado/entorno.generado.env
# -----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------
PORT=3000

# Municipio y departamento son CAMPOS, no constantes (frente F8). Estos son
# valores por defecto del formulario, lo unico atado hoy a Sevilla.
MUNICIPIO_POR_DEFECTO=Sevilla
DEPARTAMENTO_POR_DEFECTO=Valle del Cauca
